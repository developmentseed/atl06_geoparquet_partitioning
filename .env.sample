# Copy to .env, then: uv run --env-file .env cdk synth|deploy
CDK_ACCOUNT=
CDK_REGION=us-west-2
# Leave unset to have the stack create (and retain) a bucket.
# CDK_BUCKET_NAME=
CDK_EDL_SECRET_NAME=atl06/earthdata
CDK_CONVERT_CONCURRENCY=50
CDK_COMPACT_CONCURRENCY=100
# Spike settings: sample every granule, small files so a ~40-granule run yields >= 10 files.
CDK_SAMPLE_GRANULE_FRACTION=1.0
CDK_TARGET_ROWS_PER_FILE=1000000
# Compact splits any hash range above this many rows into several files (10 GB Lambda limit).
# CDK_MAX_ROWS_PER_FILE=25000000
